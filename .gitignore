# Generated by `uv run` when the Claude Code plugin's .mcp.json (uv-based
# launch, see .mcp.json / mcpb/manifest.json) runs against this repo as
# ${CLAUDE_PLUGIN_ROOT} -- environment-specific, not something to commit.
uv.lock
.env
*.secrets.yaml
config/secrets/
connections.yaml
*.epw
*.rest.clixml
*.pfx
*.key
.coverage
htmlcov/

# OAuth2 token cache (see src/nspb_rest_toolkit/oauth2.py) -- defaults to
# ~/.nspb-rest-toolkit/tokens/, outside this repo, but these patterns are a
# defensive backstop in case a connection's oauth2.token_cache_path is ever
# misconfigured to point inside it. This file holds a live refresh token --
# equivalent to a credential, never commit it.
*.token_cache.json
.nspb-rest-toolkit/
